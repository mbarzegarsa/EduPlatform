{
  "manifest_version": 3,
  "name": "سیستم صدور گواهی تحصیلی",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://sida.medu.ir/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "صدور گواهی تحصیلی"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}